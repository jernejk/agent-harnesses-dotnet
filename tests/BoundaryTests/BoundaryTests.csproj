    <Compile Include="../../demos/shared/Model.cs" Link="Demos/Model.cs" />
    <Compile Include="../../demos/shared/Outcomes.cs" Link="Demos/Outcomes.cs" />
    <Compile Include="../../demos/shared/Runner.cs" Link="Demos/Runner.cs" />
    <Compile Include="../../demos/shared/Subprocess.cs" Link="Demos/Subprocess.cs" />
    <Compile Include="../../demos/shared/Trace.cs" Link="Demos/Trace.cs" />
    <Compile Include="../../demos/shared/Ui.cs" Link="Demos/Ui.cs" />
    <Compile Include="../../demos/04-research-harness/AllowList.cs" Link="Demos/AllowList.cs" />
    <Compile Include="../../demos/04-research-harness/Citations.cs" Link="Demos/Citations.cs" />
    <Compile Include="../../demos/04-research-harness/Sources.cs" Link="Demos/Sources.cs" />
    <Compile Include="../../demos/05-diagnose-harness/CommandPolicy.cs" Link="Demos/CommandPolicy.cs" />
    <Compile Include="../../demos/06-cli-first/Bisect.cs" Link="Demos/Bisect.cs" />
    <Compile Include="../../demos/05-diagnose-harness/GitGrammar.cs" Link="Demos/GitGrammar.cs" />
    <Compile Include="../../demos/05-diagnose-harness/OrdersApi.cs" Link="Demos/OrdersApi.cs" />
