# Names only: values come from the macOS Keychain, a local secrets profile or .envrc.local, never from this file.
export DOTNET_ROOT="$HOME/.local/share/dotnet-11"
export PATH="$DOTNET_ROOT:$PATH"
export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1

# Keys never reach a shell trace: tracing is off while this file handles them.
case $- in *x*) agent_trace=1; set +x ;; *) agent_trace= ;; esac

# The stage model: gpt-6-luna on OpenAI's Responses API at reasoning low. The key is read from the
# Keychain item OPENAI_API_KEY each time this file loads and is never written to a file.
if [ -z "${AGENT_ENDPOINT:-}" ] && command -v security >/dev/null 2>&1 &&
  openai_key="$(security find-generic-password -s OPENAI_API_KEY -w 2>/dev/null)" && [ -n "$openai_key" ]; then
  export AGENT_ENDPOINT="https://api.openai.com/v1/" AGENT_API_KEY="$openai_key"
  export AGENT_MODEL="${AGENT_MODEL:-gpt-6-luna}" AGENT_API="${AGENT_API:-responses}"
  export AGENT_REASONING_EFFORT="${AGENT_REASONING_EFFORT:-low}"
fi
unset openai_key

# Without that key: Azure AI Foundry from a local secrets profile, on Chat Completions.
AGENT_PROFILE="${AGENT_PROFILE:-$HOME/.secrets/profiles/azure-ai.sh}"
if [ -z "${AGENT_ENDPOINT:-}" ] && [ -f "$AGENT_PROFILE" ]; then
  source "$AGENT_PROFILE"
  export AGENT_ENDPOINT="${AZURE_AI_SPARK_ENDPOINT%/}/openai/v1/"
  export AGENT_API_KEY="$AZURE_AI_SPARK_API_KEY"
  unset AZURE_AI_SPARK_ENDPOINT AZURE_AI_SPARK_API_KEY
  unset AZURE_AI_NEXUS_ENDPOINT AZURE_AI_NEXUS_API_KEY
fi
# The Azure profile, and an endpoint set before this file ran, keep the model they always got here.
export AGENT_MODEL="${AGENT_MODEL:-gpt-5.4-mini}"

[ -f .envrc.local ] && source .envrc.local
[ -n "$agent_trace" ] && set -x
unset agent_trace
true
