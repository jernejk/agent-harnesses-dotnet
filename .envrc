# Names only: no key or endpoint lives in this file. Values come from the macOS Keychain or from
# .envrc.local (ignored by git), which is where your own settings go. See "Configure the model".

# .NET 11: a user-local SDK in ~/.local/share/dotnet-11 (or $DOTNET_11_ROOT) goes first on PATH,
# so it can sit beside an older system SDK. Without one, the dotnet already on PATH is used.
dotnet11="${DOTNET_11_ROOT:-$HOME/.local/share/dotnet-11}"
if [ -x "$dotnet11/dotnet" ]; then
  export DOTNET_ROOT="$dotnet11"
  export PATH="$DOTNET_ROOT:$PATH"
fi
unset dotnet11
export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1

# Keys never reach a shell trace: tracing is off while this file handles them.
case $- in *x*) agent_trace=1; set +x ;; *) agent_trace= ;; esac

# Your own endpoint, key and model. When .envrc.local sets AGENT_ENDPOINT, the Keychain default
# below is skipped, so none of its settings (Responses API, reasoning low) carry over.
[ -f .envrc.local ] && source .envrc.local

# Otherwise, on a Mac with a Keychain item named OPENAI_API_KEY: OpenAI's gpt-6-luna on the
# Responses API at reasoning low. The key is read each time this file loads, never written to a file.
if [ -z "${AGENT_ENDPOINT:-}" ] && command -v security >/dev/null 2>&1 &&
  openai_key="$(security find-generic-password -s OPENAI_API_KEY -w 2>/dev/null)" && [ -n "$openai_key" ]; then
  export AGENT_ENDPOINT="https://api.openai.com/v1/" AGENT_API_KEY="$openai_key"
  export AGENT_MODEL="${AGENT_MODEL:-gpt-6-luna}" AGENT_API="${AGENT_API:-responses}"
  export AGENT_REASONING_EFFORT="${AGENT_REASONING_EFFORT:-low}"
fi
unset openai_key

# An endpoint without a model gets the model the demos were built on.
export AGENT_MODEL="${AGENT_MODEL:-gpt-5.4-mini}"

[ -n "$agent_trace" ] && set -x
unset agent_trace
true
